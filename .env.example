POSTGRES_DB=ai_process_engine
POSTGRES_USER=ai_process_engine
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://ai_process_engine:local_development_only@localhost:5433/ai_process_engine
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# A cheaper per-role model for intent extraction was evaluated on 2026-08-25
# and rejected -- it disagreed with the production model (claude-sonnet-5) on
# 15 of 48 identical inputs, including an intermittent false escalation. The
# override mechanism was removed from the codebase after that finding, so
# there is nothing to set here: one model runs everything, ANTHROPIC_MODEL
# above. See claude/unit-economics-and-urgency-default.md section 5.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:5173
PUBLIC_CHAT_RATE_LIMIT_REQUESTS=20
PUBLIC_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CONVERSATION_TOKEN_TTL_HOURS=720
PUBLIC_CHAT_MESSAGE_MAX_CHARS=2000
MAX_REQUEST_BODY_BYTES=65536
# Same value in Evorove and cycle 1. Production: openssl rand -hex 32
INTERNAL_TASK_SECRET=local_development_only
# Cycle 2 public URL for owner commands back. Host processes use localhost.
# Compose ignores this and talks to Evorove via host.docker.internal:8001.
EVOROVE_BASE_URL=http://localhost:8001
# Cycle 1's own API, for phase 3's hypothesis_id -> outcome report on
# Done/drop (hypothesis_outcome_client.py). Same INTERNAL_TASK_SECRET as
# above. Unset means outcomes are never reported -- silent, not an error.
EVOROVE_LEAD_BASE_URL=
# Password reset mail is disabled until all SMTP values below are set in the deployment.
FRONTEND_BASE_URL=
ACCOUNT_SECURITY_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
